[
    {
        "test_name": "Valid Login",
        "email_username": "Admin",
        "password": "admin123",
        "expected": "Success"
    },
    {
        "test_name": "Invalid Password",
        "email_username": "Admin",
        "password": "wrong123",
        "expected": "Invalid credentials"
    },
    {
        "test_name": "Invalid Username",
        "email_username": "WrongAdmin",
        "password": "admin123",
        "expected": "Invalid credentials"
    },
    {
        "test_name": "Invalid Username and Password",
        "email_username": "WrongAdmin",
        "password": "wrong123",
        "expected": "Invalid credentials"
    },
    {
        "test_name": "Blank Username",
        "email_username": "",
        "password": "admin123",
        "expected": "Required"
    },
    {
        "test_name": "Blank Password",
        "email_username": "Admin",
        "password": "",
        "expected": "Required"
    },
    {
        "test_name": "Blank Username and Password",
        "email_username": "",
        "password": "",
        "expected": "Required"
    },
    {
        "test_name": "Username with Spaces",
        "email_username": "   ",
        "password": "admin123",
        "expected": "Required"
    },
    {
        "test_name": "Password with Spaces",
        "email_username": "Admin",
        "password": "   ",
        "expected": "Required"
    },
    {
        "test_name": "Leading Trailing Spaces in Username",
        "email_username": " Admin ",
        "password": "admin123",
        "expected": "Invalid credentials"
    },
    {
        "test_name": "Case Sensitive Username",
        "email_username": "admin",
        "password": "admin123",
        "expected": "Invalid credentials"
    },
    {
        "test_name": "Case Sensitive Password",
        "email_username": "Admin",
        "password": "Admin123",
        "expected": "Invalid credentials"
    },
    {
        "test_name": "Special Characters Username",
        "email_username": "@Admin#$",
        "password": "admin123",
        "expected": "Invalid credentials"
    },
    {
        "test_name": "SQL Injection",
        "email_username": "' OR '1'='1",
        "password": "' OR '1'='1",
        "expected": "Invalid credentials"
    },
    {
        "test_name": "XSS Attack",
        "email_username": "<script>alert('XSS')</script>",
        "password": "admin123",
        "expected": "Invalid credentials"
    },
    {
        "test_name": "Very Long Username",
        "email_username": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
        "password": "admin123",
        "expected": "Invalid credentials"
    },
    {
        "test_name": "Very Long Password",
        "email_username": "Admin",
        "password": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
        "expected": "Invalid credentials"
    }
]